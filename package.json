{
  "name": "wait-on",
  "description": "wait-on is a cross platform command line utility and Node.js API which will wait for files, ports, sockets, and http(s) resources to become available",
  "version": "10.0.0-rc.1",
  "type": "commonjs",
  "main": "lib/wait-on",
  "types": "index.d.ts",
  "bin": {
    "wait-on": "bin/wait-on"
  },
  "files": [
    "bin/",
    "lib/",
    "prebuilds/",
    "exampleConfig.js",
    "index.d.ts"
  ],
  "author": "Jeff Barczewski <info@codewinds.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffbski/wait-on.git"
  },
  "bugs": {
    "url": "http://github.com/jeffbski/wait-on/issues"
  },
  "license": "MIT",
  "scripts": {
    "bench:startup": "node scripts/bench-startup.js",
    "build:napi": "node scripts/build-napi.js",
    "ci:rs": "node scripts/ci-rs.js",
    "lint": "eslint \"lib/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\" \"benchmarks/**/*.js\" \"bin/wait-on\"",
    "test": "npm run lint && npm run test:types && npm run test:mocha",
    "test:coverage": "nyc npm run test:mocha",
    "test:mocha": "mocha --exit \"test/**/*.mocha.js\"",
    "test:types": "tsc -p test/tsconfig.json",
    "ci:rs:package": "node scripts/ci-rs-package.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.5",
    "@types/node": "^26.6.3",
    "chai": "^6.2.2",
    "eslint": "^10.11.0",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "globals": "^17.12.0",
    "mkdirp": "^3.0.1",
    "mocha": "^12.0.2",
    "nyc": "^18.0.0",
    "temp": "^0.9.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "joi": "^18.2.9",
    "rxjs": "^7.8.2",
    "undici": "^8.10.2"
  },
  "keywords": [
    "wait",
    "delay",
    "cli",
    "files",
    "tcp",
    "ports",
    "sockets",
    "http",
    "exist",
    "ready",
    "available",
    "portable",
    "cross-platform",
    "unix",
    "linux",
    "windows",
    "win32",
    "osx"
  ]
}
